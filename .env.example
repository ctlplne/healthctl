# Run python3 scripts/init.py to create .env with randomly generated installation keys.
POSTGRES_PASSWORD=
CLINICAL_DATA_KEY=
CLINICAL_PORT=8437
CLINICAL_DISPLAY_NAME=healthctl
# Optional deployment-specific emergency contact, e.g. verified local number and service.
CLINICAL_EMERGENCY_CONTACT=
CLINICAL_LOCALE=en
CLINICAL_UNITS=as-reported
CLINICAL_CARE_DESTINATION=
# Enable for access through an HTTPS reverse proxy.
CLINICAL_SECURE_COOKIE=false
CLINICAL_PUBLIC_ORIGIN=
# Exact comma-separated compatible service base URLs, including API path.
CLINICAL_ALLOWED_ENDPOINTS=
# Optional user-authorized, read-only SMART portal. See docs/ehr.md.
CLINICAL_EHR_NAME=
CLINICAL_EHR_FHIR_BASE=
CLINICAL_EHR_AUTHORIZE_URL=
CLINICAL_EHR_TOKEN_URL=
CLINICAL_EHR_CLIENT_ID=
CLINICAL_EHR_REDIRECT_URI=
CLINICAL_EHR_AUTH_ISSUER=
# Optional credentials are loaded by the backend. Do not enter them in a browser.
OPENAI_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
BYOM_API_KEY=
BYOM_KEY_ENDPOINT=

# Optional local qualification rates (JSON).
CLINICAL_MODEL_PRICES=
# Scheduled backups run by default. init.py sets the folder outside Docker and
# this checkout. On Linux it also sets the user that writes there.
CLINICAL_BACKUP_DIRECTORY=
CLINICAL_BACKUP_USER=
CLINICAL_BACKUP_INTERVAL_HOURS=24
CLINICAL_BACKUP_KEEP=7
